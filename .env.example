# WordPress Site Configuration
WORDPRESS_URL=https://brighterwebsites.com.au
WORDPRESS_API_BASE=/wp-json/brighter-core/v1

# WordPress API Token (from WordPress Admin → Brighter Support → API Settings)
WORDPRESS_API_TOKEN=your_secure_token_here

# MCP Server Configuration
MCP_SERVER_NAME=BrighterWebsites WordPress MCP
MCP_SERVER_VERSION=1.0.0

# Remote MCP Server (HTTP/SSE) Configuration
PORT=3000
BASE_URL=https://mcp.brighterwebsites.com.au
MCP_API_KEY=your-secure-api-key-here-change-this

# OAuth 2.0 Configuration (for Claude.ai, ChatGPT, OpenAI Agents)
OAUTH_CLIENT_ID=brighterwebsites-mcp-client
OAUTH_CLIENT_SECRET=generate-with-node-crypto-command
